APP_NAME=SmartTaskAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ==========================================
# 🔀 SWITCH MATRIX — Same as all other backends
# ==========================================
DB_TYPE=POSTGRES           # POSTGRES | MONGO
BROKER_TYPE=BULLMQ         # BULLMQ | RABBITMQ
AI_PROVIDER=MOCK           # GEMINI | MOCK
AUTH_TYPE=JWT              # JWT | SESSION
LOGGER_TYPE=MONOLOG        # MONOLOG (only one in PHP, but structured for pattern parity)

# ==========================================
# 🗄️ Database (PostgreSQL)
# ==========================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smart_task_ai
DB_USERNAME=user
DB_PASSWORD=password

# ==========================================
# 🍃 Database (MongoDB) — when DB_TYPE=MONGO
# ==========================================
MONGO_URI=mongodb://localhost:27017/smart_task_ai

# ==========================================
# 🔐 Auth
# ==========================================
JWT_SECRET=super-secret-key-change-in-production
JWT_TTL=1440
SESSION_LIFETIME=120

# ==========================================
# 📦 Redis / BullMQ
# ==========================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

# ==========================================
# 🐇 RabbitMQ — when BROKER_TYPE=RABBITMQ
# ==========================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ==========================================
# 🤖 AI Provider — when AI_PROVIDER=GEMINI
# ==========================================
GEMINI_API_KEY=

# ==========================================
# 🌐 CORS
# ==========================================
FRONTEND_URL=http://localhost:4200
